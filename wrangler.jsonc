{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transport-scanner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Never remove variables or secrets added in the Cloudflare dashboard when deploying
  "keep_vars": true,
  // The front end (public/) is bundled into the Worker as text modules
  "rules": [{ "type": "Text", "globs": ["**/index.html", "**/app.css", "**/app.js"], "fallthrough": true }],
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "transport-scanner", "database_id": "83d94bb1-2c61-4d0a-b795-17c54aac6c34" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "742c40d6dd7946a5af983b1c36ce8db8" }
  ],
  // One Workflow instance per slip: runs many slips in parallel with automatic retries
  "workflows": [{ "name": "transport-scanner-ocr", "binding": "OCR_FLOW", "class_name": "OcrWorkflow" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // Workers AI models used when no ANTHROPIC_API_KEY secret is set
    "VISION_MODELS": "@cf/qwen/qwen3.8-27b,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/google/gemma-4-26b-a4b-it",
    "MERGE_MODEL": "@cf/openai/gpt-oss-120b",
    // Used only when an ANTHROPIC_API_KEY secret is set
    "CLAUDE_MODEL": "claude-haiku-5-5"
  },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 }
}
